FROM golang:1.26 AS builder

WORKDIR /src
ENV GO111MODULE=off
COPY cmd/mock-api/main.go .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /mock-api main.go

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /mock-api /mock-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/mock-api"]
